<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 디버그 빌드에서만 로컬 테스트 서버(http)로 업데이트 흐름을 검증할 수 있게 허용 -->
    <application android:usesCleartextTraffic="true">
        <!-- 번역 벤치마크 실행기. bench/run.sh 가 adb 로 띄운다. -->
        <activity
            android:name=".bench.BenchActivity"
            android:exported="true"
            android:label="번역 벤치마크" />
        <!-- 음성 인식 벤치마크 실행기. bench/stt/run.sh 가 adb 로 띄운다. -->
        <activity
            android:name=".bench.SttBenchActivity"
            android:exported="true"
            android:label="음성 인식 벤치마크" />
    </application>
</manifest>
